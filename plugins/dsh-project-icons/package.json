{
  "name": "@local/dsh-project-icons",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": { "dsh": "0.2.2-rc.5" },
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "icon-finder.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "description": "Show project icons and details in the sidebar, align session status to the trailing edge, and allow a narrower sidebar."
}
