{
  "name": "@local/dsh-project-icons",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "icon-finder.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "client.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "description": "Show sidebar project icons and align session status markers to the trailing edge."
}
