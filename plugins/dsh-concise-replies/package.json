{
  "name": "@local/dsh-concise-replies",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Plain-language task results and AI-suggested next tasks accepted with Tab in the composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "next-task.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "reply-policy.txt"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-conversation"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
